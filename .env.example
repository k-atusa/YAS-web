# Server Port (default: 4000)
PORT=4000

# Optional: Secret key for JWT signing
# If omitted, a cryptographically secure random 32-byte secret is generated in memory on startup.
# Set this only if you want sessions to persist across server restarts.
# JWT_SECRET=change-this-to-a-random-secret-key

# Optional: Domain name for WebAuthn passkeys (default: localhost, e.g. example.com in production)
# DOMAIN=localhost
